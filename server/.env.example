# ==============================================================================
# DISPLAYFLOW — CREDENCIAIS OFICIAIS DO M-PESA MOÇAMBIQUE (VODACOM)
# Obtenha em: https://developer.mpesa.vm.co.mz/
# ==============================================================================

# Porta do Servidor Local
PORT=3001

# Ambiente: 'sandbox' para testes ou 'live' para produção
MPESA_ENV=sandbox

# API Key de 32 caracteres (Account Profile > Security)
MPESA_API_KEY=

# Chave Pública RSA da Vodacom (4096 bits, formato base64/PEM)
MPESA_PUBLIC_KEY=

# Código de Provedor de Serviço atribuído à sua empresa pela Vodacom (ex: 171717)
MPESA_SERVICE_PROVIDER_CODE=

# Credenciais de Segurança para Reversão/Estorno (Portal Vodacom)
MPESA_INITIATOR_IDENTIFIER=
MPESA_SECURITY_CREDENTIAL=
